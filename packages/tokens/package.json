{
  "name": "@thenexlabs/tokens",
  "version": "0.1.0",
  "description": "NEX Level Labs design tokens: CSS variables, Tailwind preset and JS/TS exports",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenexlabs/nex-toolkit.git",
    "directory": "packages/tokens"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test scripts/check.mjs",
    "prepare": "node scripts/build.mjs",
    "prepublishOnly": "yarn test"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
